# ============================================
# TOK Product Automation - Environment Config
# ============================================

# --- Backend API (Production) ---
# Use production URLs for live deployment
API_BASE_URL=

# Admin API base URL
ADMIN_API_BASE_URL=

# --- Email for OTP (Auto-login) ---
# OTP will be sent to this email
EMAIL_FOR_OTP=monirhasnan@gmail.com

# --- OpenRouter AI ---
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model to use for generating product details
# Recommended models:
#   deepseek/deepseek-v3.2        - Best quality/cost balance
#   x-ai/grok-4.1-fast            - Fast responses
#   qwen/qwen3.5-flash-02-23      - Good quality, fast
#   google/gemma-4-26b-a4b-it     - Good for technical content
OPENROUTER_MODEL=xiaomi/mimo-v2-flash

# --- Excel File ---
# Path to the Excel file containing product data
# Required columns: name, price
# All other fields (brand, category, origin, etc.) will be generated by AI
EXCEL_FILE=TOK-CERAVE-CETAPHIL.xlsx

# The sheet name in the Excel file (default: Sheet1)
EXCEL_SHEET=Sheet

# --- Image Download ---
# Directory to temporarily store downloaded product images
DOWNLOAD_DIR=./downloads

# Whether to run Playwright browser in headless mode (true/false)
HEADLESS=true

# --- Processing ---
# Delay in seconds between processing each product (to be nice to APIs)
PRODUCT_DELAY=2

# Whether to skip AI generation and only do image search + product posting
# Set to "false" to use AI, "true" to skip AI (data from Excel will be used)
SKIP_AI=false

# Whether to skip image search (if you already have images or just want to test)
# Set to "true" to skip image download
SKIP_IMAGES=false

# --- TUI Settings ---
# Whether to use the TUI (Text User Interface) instead of CLI
USE_TUI=false
